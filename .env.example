# Port server API (default: 3001)
PORT=3001

# Password untuk masuk ke dashboard.
# Kosongkan = dashboard terbuka tanpa login.
DASHBOARD_PASSWORD=

# Kunci rahasia untuk menandatangani sesi login (opsional).
# Kalau kosong, otomatis diturunkan dari DASHBOARD_PASSWORD.
DASHBOARD_SECRET=

# ---------------------------------------------------------------
# Penyimpanan lewat GitHub API (wajib di Vercel)
#
# Di Vercel filesystem-nya read-only dan hilang tiap deploy, jadi post
# disimpan dengan meng-commit file .md ke repo. Lokal tidak perlu diisi —
# post langsung ditulis ke folder blog-posts/.
# ---------------------------------------------------------------

# Token dengan skop "Contents: Read and write" ke repo ini.
# https://github.com/settings/tokens  (atau fine-grained token)
GITHUB_TOKEN=

# Format: owner/nama-repo.
# Di Vercel ini bisa dibiarkan kosong kalau proyeknya tersambung ke repo,
# karena owner & nama repo ikut terbaca dari variabel bawaan Vercel.
GITHUB_REPOSITORY=

# Cabang tujuan post (default: main)
GITHUB_BRANCH=main
